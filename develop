#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
CORE_DIR="$ROOT_DIR/core"
COMPOSE_FILE="$CORE_DIR/infrastructure/local/docker-compose.yaml"
ROOT_PARENT_DIR="$(CDPATH= cd -- "$ROOT_DIR/.." && pwd)"
if [ "$ROOT_PARENT_DIR" = "/" ]; then
  DEFAULT_CREDENTIALS_DIR="/.credentials"
else
  DEFAULT_CREDENTIALS_DIR="$ROOT_PARENT_DIR/.credentials"
fi
CREDENTIALS_DIR="${CREDENTIALS_DIR:-$DEFAULT_CREDENTIALS_DIR}"

BACKEND_SERVICES="postgres-1 postgres-2 gcs-emulator redis-1 redis-2 api-1 api-2 api-3"
LOG_SERVICES="api-1 api-2 api-3 postgres-1 postgres-2 redis-1 redis-2 gcs-emulator"
TEST_ENV_VARS="
API_HOST
API_HOSTS
API_PORT
SERVER_COUNT
ALIAS_COUNT
TEST_GREP
TEST_TIMEOUT
TEST_STARTUP_TIMEOUT
TEST_URL
DEV_CONTROL_TOKEN
DEV_CONTROL_TIMEOUT
BROWSER_LOGS
HEADED
API_PREFLIGHT_TIMEOUT
"
REQUIRED_CREDENTIALS="
AUTH_SERVICE_SECRET_KEY
OAUTH_CREDENTIALS
SSL_CERT
SSL_KEY
GCS_SERVICE_ACCOUNT_CREDENTIALS
PUBLIC_ENCRYPTION_KEY
SECRET_ENCRYPTION_KEY
"

usage() {
  cat <<EOF
Usage: ./develop [command]

Development tools:
  menu                 Show the fzf interactive menu
  backend | up         Start the local core backend in Docker Compose
  codex                Open the Docker Compose Codex development session
  logs [services...]   Follow Docker Compose logs (defaults to backend services)
  test                 Run the embedded test suite in the Codex container
  browser-test         Run the browser test suite in the Codex container
  cross-test           Run the cross-server browser suite in the Codex container
  production-ssh       Connect to a production server over SSH
  status               Show Docker Compose service status
  down                 Stop the local Docker Compose stack

Examples:
  ./develop backend
  ./develop logs api-1
  ./develop codex
  ./develop test
  ./develop production-ssh

Credentials default to:
  $DEFAULT_CREDENTIALS_DIR

Override with:
  CREDENTIALS_DIR=/path/to/.credentials ./develop backend
EOF
}

ensure_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "docker is required but was not found in PATH" >&2
    exit 1
  fi
}

ensure_gcloud() {
  if ! command -v gcloud >/dev/null 2>&1; then
    echo "gcloud is required but was not found in PATH" >&2
    exit 1
  fi
}

load_credentials() {
  missing=0
  for name in $REQUIRED_CREDENTIALS; do
    if [ ! -f "$CREDENTIALS_DIR/$name" ]; then
      echo "Missing credential file: $CREDENTIALS_DIR/$name" >&2
      missing=1
    fi
  done

  if [ "$missing" -ne 0 ]; then
    echo "Credentials directory: $CREDENTIALS_DIR" >&2
    echo "Set CREDENTIALS_DIR=/path/to/.credentials to override." >&2
    exit 1
  fi

  export AUTH_SERVICE_SECRET_KEY="$(cat "$CREDENTIALS_DIR/AUTH_SERVICE_SECRET_KEY")"
  export OAUTH_CREDENTIALS="$(cat "$CREDENTIALS_DIR/OAUTH_CREDENTIALS")"
  export SSL_CERT="$(cat "$CREDENTIALS_DIR/SSL_CERT")"
  export SSL_KEY="$(cat "$CREDENTIALS_DIR/SSL_KEY")"
  export GCS_SERVICE_ACCOUNT_CREDENTIALS="$(cat "$CREDENTIALS_DIR/GCS_SERVICE_ACCOUNT_CREDENTIALS")"
  export PUBLIC_ENCRYPTION_KEY="$(cat "$CREDENTIALS_DIR/PUBLIC_ENCRYPTION_KEY")"
  export SECRET_ENCRYPTION_KEY="$(cat "$CREDENTIALS_DIR/SECRET_ENCRYPTION_KEY")"
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

run_in_codex() {
  ensure_docker
  load_credentials
  ensure_codex_home

  local env_args=()
  local tty_args=()
  local name
  for name in $TEST_ENV_VARS; do
    if [ "${!name+x}" = x ]; then
      env_args+=("-e" "$name")
    fi
  done

  if [ ! -t 0 ] || [ ! -t 1 ]; then
    tty_args+=("-T")
  fi

  compose run --rm --build "${tty_args[@]}" "${env_args[@]}" --entrypoint bash codex -lc "$*"
}

ensure_codex_home() {
  mkdir -p "$ROOT_DIR/.codex-home/.codex"

  if [ ! -f "$ROOT_DIR/.codex-home/.codex/AGENTS.md" ]; then
    cat > "$ROOT_DIR/.codex-home/.codex/AGENTS.md" <<'EOF'
Before taking actions that materially change approach, architecture, data shape, or irreversible state, ask briefly for confirmation.

Do not ask for permission for routine read, write, or bash operations inside this container.
EOF
  fi
}

start_backend() {
  ensure_docker
  load_credentials
  compose up -d --build $BACKEND_SERVICES
}

open_codex() {
  ensure_docker
  load_credentials
  ensure_codex_home
  compose run --rm --build codex "$@"
}

follow_logs() {
  ensure_docker
  load_credentials
  if [ "$#" -gt 0 ]; then
    compose logs -f --tail="${LOG_TAIL:-200}" "$@"
  else
    compose logs -f --tail="${LOG_TAIL:-200}" $LOG_SERVICES
  fi
}

run_test() {
  run_in_codex "cd /workspace/test && npm test"
}

run_browser_test() {
  run_in_codex "cd /workspace/test && npm run test:local"
}

run_cross_test() {
  run_in_codex "cd /workspace/test && npm run test:cross-server"
}

connect_production_ssh() {
  ensure_gcloud
  bash "$CORE_DIR/infrastructure/GCP/connect.sh"
}

show_menu() {
  usage
  cat <<EOF

Run ./develop from a terminal to select options interactively.
EOF
}

interactive_menu() {
  if [ ! -t 0 ]; then
    show_menu
    return 0
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    usage
    cat <<EOF

Install fzf for the interactive selector, or run one of the commands above directly.
EOF
    return 0
  fi

  local selection
  selection="$(
    cat <<EOF | fzf \
      --height=15 \
      --border \
      --prompt='develop> ' \
      --header='Select a development tool. Enter runs it; Esc cancels.' \
      --delimiter='\t' \
      --with-nth=2.. \
      --no-multi
backend	Start core backend
codex	Open Codex session
logs	Follow backend logs
test	Run embedded test suite in Codex container
browser-test	Run browser test suite in Codex container
cross-test	Run cross-server browser test suite in Codex container
production-ssh	Connect to a production server over SSH
status	Show Compose status
down	Stop Compose stack
quit	Quit
EOF
  )" || return 0

  command="${selection%%	*}"

  case "$command" in
    backend) start_backend ;;
    codex) open_codex ;;
    logs) follow_logs ;;
    test) run_test ;;
    browser-test) run_browser_test ;;
    cross-test) run_cross_test ;;
    production-ssh) connect_production_ssh ;;
    status) ensure_docker; load_credentials; compose ps ;;
    down) ensure_docker; load_credentials; compose down --remove-orphans ;;
    quit|"") exit 0 ;;
    *) echo "Unknown menu selection: $selection" >&2; exit 1 ;;
  esac
}

command="${1:-menu}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  menu) interactive_menu ;;
  -h|--help|help) usage ;;
  backend|up|start) start_backend ;;
  codex) open_codex "$@" ;;
  logs) follow_logs "$@" ;;
  test) run_test ;;
  browser-test|test:local) run_browser_test ;;
  cross-test|test:cross-server) run_cross_test ;;
  production-ssh) connect_production_ssh ;;
  status|ps) ensure_docker; load_credentials; compose ps ;;
  down|stop) ensure_docker; load_credentials; compose down --remove-orphans ;;
  *) usage >&2; printf "\nUnknown command: %s\n" "$command" >&2; exit 1 ;;
esac
